# =============================================================================
# Shared client env (monorepo root). Copy to ".env.local" and fill in values.
# Both apps/bridge and apps/hyperfx load from this directory (see envDir in
# each vite.config.ts). Vercel: set the same VITE_* keys on each project.
# =============================================================================

# --- App & UX ---
VITE_APP_ENV=local
# production | staging | local (see @hyperbridge-fe/shared AppEnv)

VITE_LOG_LEVEL=info

# Public site URL for non-production builds (local / preview). Vercel sets
# VERCEL_BRANCH_URL at build time; envPrefix in Vite also exposes VERCEL_*.
# VITE_VERCEL_BRANCH_URL=my-branch.vercel.app

# --- Wallet & RPC (from old bridge app; required for wallet + chain RPC) ---
VITE_WALLETCONNECT_ID=
VITE_ANKR_API_KEY=
VITE_ALCHEMY_API_KEY=

# --- Indexer ---
VITE_MAINNET_INDEXER_URL=
VITE_TESTNET_INDEXER_URL=

# --- Analytics & monitoring ---
VITE_GOOGLE_ANALYTICS_ID=
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=